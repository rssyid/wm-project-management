# Database (Neon). DATABASE_URL = pooled (runtime). DIRECT_URL = koneksi langsung (prisma.config.ts / migrasi).
# Contoh: postgresql://user:pass@host/dbname?sslmode=verify-full
# Jangan pakai sslmode=prefer/require/verify-ca (pg-connection-string memperingatkan ini; berubah di v3).
DATABASE_URL=
DIRECT_URL=

# Branch Neon `test` untuk integration test dan e2e; dijalankan lewat `pnpm db:test:prepare`.
TEST_DATABASE_URL=
TEST_DIRECT_URL=

# Better Auth
# Di produksi isi origin persis seperti yang dilihat browser, tanpa path dan tanpa garis
# miring akhir, contoh: https://wm-project-management.vercel.app
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Aplikasi
APP_TIMEZONE=Asia/Jakarta

# Test Playwright: akun uji dibuat ulang tiap `pnpm test:e2e` oleh `pnpm seed:e2e`.
# Tidak ada variabel tambahan; email dan password akun uji ada di tests/e2e/accounts.ts.

# Seed Super Admin pertama (hanya dipakai saat seed)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Backup (hanya di GitHub Actions secrets, bukan di aplikasi): R2_BACKUP_BUCKET, R2_BACKUP_ACCESS_KEY_ID, R2_BACKUP_SECRET_ACCESS_KEY
