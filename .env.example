# Database (Neon). DATABASE_URL = pooled (runtime). DIRECT_URL = koneksi langsung (prisma.config.ts / migrasi).
DATABASE_URL=
DIRECT_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Aplikasi
APP_TIMEZONE=Asia/Jakarta

# Seed Super Admin pertama (hanya dipakai saat seed)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Backup (hanya di GitHub Actions secrets, bukan di aplikasi): R2_BACKUP_BUCKET, R2_BACKUP_ACCESS_KEY_ID, R2_BACKUP_SECRET_ACCESS_KEY
